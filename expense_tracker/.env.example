# Copy this file to expense_tracker/.env and fill in values. Never commit .env.
# A key saved in Settings (data/openai_key.txt) still wins over OPENAI_API_KEY.

# OpenAI — used for Sort with ChatGPT if data/openai_key.txt is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite database path
EXPENSE_DB=data/expenses.db

# Flask (change SECRET_KEY if you expose this app beyond this machine)
SECRET_KEY=local-expense-tracker-dev-key
FLASK_DEBUG=1
FLASK_PORT=5000
